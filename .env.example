# ==========================================
# PROZQEN BACKEND - ENVIRONMENT VARIABLES
# ==========================================

# SERVER
PORT=3000
NODE_ENV=development

# ==========================================
# DATABASE (PostgreSQL / Supabase)
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/prozqen_dev

# ==========================================
# ANTHROPIC (Claude API)
# ==========================================
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ==========================================
# JWT SECRETS
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# ==========================================
# STRIPE (Payments)
# ==========================================
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ==========================================
# EMAIL (Resend)
# ==========================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=support@prozqen.fr

# ==========================================
# CONNECTEURS
# ==========================================

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=xxxxxxxxxxxxx
LINKEDIN_CLIENT_SECRET=xxxxxxxxxxxxx
LINKEDIN_REDIRECT_URI=http://localhost:3000/connectors/linkedin/callback

# Google (Sheets + OAuth)
GOOGLE_SHEETS_API_KEY=xxxxxxxxxxxxx
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxxx
GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/connectors/google/callback

# Calendly
CALENDLY_API_KEY=xxxxxxxxxxxxx

# CRM Integration (choose one or all)
PIPEDRIVE_API_KEY=xxxxxxxxxxxxx
HUBSPOT_API_KEY=xxxxxxxxxxxxx
ZENDESK_API_KEY=xxxxxxxxxxxxx

# ==========================================
# REDIS (Optional - for queue/cache)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=debug
LOG_FILE=logs/prozqen.log

# ==========================================
# FRONTEND URL (for CORS)
# ==========================================
FRONTEND_URL=http://localhost:3000
FRONTEND_PROD_URL=https://prozqen.vercel.app

# ==========================================
# PRODUCTION FLAGS
# ==========================================
ALLOW_SIGNUPS=true
MAINTENANCE_MODE=false
